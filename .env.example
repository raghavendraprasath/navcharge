# OpenSky Network, OAuth2 client credentials
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_DAILY_CREDIT_BUDGET=4000
OPENSKY_BBOX_MIN_LAT=45.0
OPENSKY_BBOX_MAX_LAT=55.0
OPENSKY_BBOX_MIN_LON=2.0
OPENSKY_BBOX_MAX_LON=15.0

# PostgreSQL with PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=navcharge
POSTGRES_USER=navcharge
POSTGRES_PASSWORD=

# MongoDB, rate card catalog
MONGO_URI=mongodb://localhost:27017
MONGO_DB=navcharge_rates

# Redis, idempotency and quota
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_POSITIONS=usage.positions.v1
KAFKA_TOPIC_CORRECTIONS=usage.corrections.v1
KAFKA_TOPIC_CHARGES=billing.charges.v1
KAFKA_TOPIC_DLQ=usage.positions.dlq

# Admission service
ADMISSION_GRPC_PORT=9090
ADMISSION_HTTP_PORT=8080
IDEMPOTENCY_WINDOW_SECONDS=900
